  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
